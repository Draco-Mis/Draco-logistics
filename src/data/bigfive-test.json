  "dimensions": {
    "E": {
      "label": "外向性",
      "short_desc": "Extraversion — 社交、活躍、果斷",
      "high_desc": "外向、健談、充滿活力，喜歡與人互動，在團體中常扮演主動發言或帶動氣氛的角色，能量來自外部互動。",
      "low_desc": "內斂、安靜、深思，偏好獨處或小型互動，能量來自獨自思考與沉澱，不代表害羞而是更聚焦於內在世界。"
    },
    "A": {
      "label": "親和性",
      "short_desc": "Agreeableness — 信任、合作、利他",
      "high_desc": "友善、合作、富同理心，傾向相信他人並樂於幫助，是團隊裡的潤滑劑；衝突中常扮演調解者。",
      "low_desc": "直率、競爭性強，注重事實與邏輯多於感受；不害怕表達異議，善於談判，但需注意人際細膩度。"
    },
    "C": {
      "label": "盡責性",
      "short_desc": "Conscientiousness — 自律、有計畫、可靠",
      "high_desc": "勤勉、有條理、自律，習慣訂目標並追蹤進度；可靠、守時，能勝任需要嚴謹流程的工作。",
      "low_desc": "彈性、隨興，偏好邊做邊調整而非預先規劃；面對突發狀況反應快，但需注意截止期限的紀律。"
    },
    "N": {
      "label": "神經質",
      "short_desc": "Neuroticism — 情緒波動、敏感度",
      "high_desc": "敏感、容易感到壓力或焦慮，但同時對風險與細節較敏銳；需要適度的情緒管理與支持系統。",
      "low_desc": "情緒穩定、抗壓性強，能在壓力下保持理性決策；遇到挫折恢復快，是危機處理時的定海神針。"
    },
    "O": {
      "label": "開放性",
      "short_desc": "Openness — 好奇心、創新、想像力",
      "high_desc": "好奇、有創意、思維開放，喜歡新觀念與多元嘗試，適合需要創新或跨領域整合的工作。",
      "low_desc": "務實、傳統，偏好已驗證的方法與既定流程，執行力強且穩定，是維持系統穩定運作的關鍵角色。"
    }
  },
